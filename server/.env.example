# Copy to server/.env and adjust. Defaults match docker-compose.yml.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://oj:oj_dev_password@localhost:5432/online_judge
REDIS_URL=redis://localhost:6379

# Change this in any real deployment (min 32 characters).
JWT_SECRET=dev-only-secret-change-me-please-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173

# Judge
SANDBOX_IMAGE=oj-sandbox:latest
DOCKER_BIN=docker
WORKER_CONCURRENCY=2

# Rate limits (per user, per minute)
SUBMIT_RATE_LIMIT=12
RUN_RATE_LIMIT=20

# Seeded admin account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
